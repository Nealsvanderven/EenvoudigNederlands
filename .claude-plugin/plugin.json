{
  "name": "eenvoudig-nederlands",
  "displayName": "Eenvoudig Nederlands",
  "description": "Schrijf helder Nederlands op taalniveau B1 (referentieniveau 2F): korte zinnen, actieve vorm, werkwoordstijl, geen tangconstructies, geen ambtelijke taal, elke vakterm uitgelegd bij het eerste gebruik. Bespaart tokens, want de regels halen de opvulling uit documenten en antwoorden.",
  "version": "1.6.0",
  "author": {
    "name": "Neals van der Ven"
  },
  "homepage": "https://github.com/Nealsvanderven/EenvoudigNederlands",
  "repository": "https://github.com/Nealsvanderven/EenvoudigNederlands",
  "license": "MIT",
  "keywords": [
    "nederlands",
    "taalniveau-b1",
    "klare-taal",
    "documentatie",
    "technisch-schrijven"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/eenvoudig-nederlands-activate.js\"",
            "timeout": 5,
            "statusMessage": "Eenvoudig Nederlands laden..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "Eenvoudig Nederlands: bestand controleren..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
